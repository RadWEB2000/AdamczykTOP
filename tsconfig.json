{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "importHelpers": true,
    "allowArbitraryExtensions":true,
    "mapRoot":"https://adamczyk.top",
    "sourceMap": true,
    "verbatimModuleSyntax":true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/app/*":["./app/*"],
      "@/assets/*":["./assets/*"],
      "@/docs/*":["./assets/documents/*"],
      "@/fonts/*":["./assets/fonts/*"],
      "@/img/*":["./assets/images/*"],
      "@/movies/*":["./assets/movies/*"],
      "@/icons/*":["./assets/icons/*"],
      "@/components/*":["./components/*"],
      "@/common/*":["./components/common/*"],
      "@/buttons/*":["./components/common/buttons/*"],
      "@/cards/*":["./components/common/cards/*"],
      "@/utils/*":["./components/common/utils/*"],
      "@/shared/*":["./components/shared/*"],
      "@/views/*":["./components/views/*"],
      "@/context/*":["./context/*"],
      "@/data/*":["./data/*"],
      "@/lib/*":["./lib/*"],
      "@/configs/*":["./lib/configs/*"],
      "@/funcs/*":["./lib/functions/*"],
      "@/hooks/*":["./lib/hooks/*"],
      "@/providers/*":["./providers/*"],
      "@/css/*":["./styles/*"],
      "@/ts/*":["./types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
