    --rotate:0deg;
    --rotate-first:var(--rotate);
    --rotate-last:var(--rotate);
    --translate:150%;
    --translate-first:calc(var(--translate) * -1);
    --translate-last:var(--translate);
    align-items: center;
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    height: var(--size);
    justify-content: space-evenly;
    padding: var(--padding);
    position: relative;
    transform:scale(var(--scale));
    transition: var(--easing) transform;
    width: var(--size);
    &:active {
      --scale:.95;
    }
    &[data-expanded=true]{
      --rotate-first:45deg;
      --rotate-last:-45deg;
      --translate-first:0%;
      --translate-last:0%;
    }
    & > .line {
      background-color: var(--color);
      border-radius: var(--radius);
      display: block;
      height: var(--line);
