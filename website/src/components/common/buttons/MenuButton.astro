---

---

<button
  :aria-expanded="$store.navigation.open"
  :aria-label="$store.navigation.open ? 'Zamknij menu' : 'Otwórz menu'"
  :data-open-menu="$store.navigation.open"
  @click="$store.navigation.toggle()"
  class="menu-button"
>
  <span class="menu-button__line"></span>
  <!-- <span class="menu-button__line"></span> -->
  <span class="menu-button__line"></span>
</button>

<style>
  .menu-button {
    --size: 3.45rem;
    padding: 0.15rem;
    display: flex;
    flex-flow: column;
    overflow: hidden;
    flex-shrink: 0;
    justify-content: space-evenly;
    height: var(--size);
    width: var(--size);
    transition: 0.2s ease-in-out transform;
    position: relative;
  }

  .menu-button:active {
    transform: scale(0.95);
  }

  .menu-button__line {
    height: 4px;
    border-radius: 2px;
    width: 100%;
    background-color: var(--color-base-1000);
    transition:
      0.2s ease-in-out transform,
      0.32s ease-in-out background-color;
    transform-origin: center;
    display: block;
  }

  .menu-button[data-open-menu="true"] > .menu-button__line:nth-of-type(1) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .menu-button[data-open-menu="true"] > .menu-button__line:nth-of-type(2) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }
</style>
