---
let isOpenMenu = false;

function handleButton() {
  isOpenMenu = !isOpenMenu;
}
---

<button class="menu-button" data-open-menu={isOpenMenu}>
  <span class="menu-button__line"></span>
  <span class="menu-button__line"></span>
  <span class="menu-button__line"></span>
</button>

<style>
  .menu-button {
    --size: 3.85rem;
    padding: 0.15rem;
    display: flex;
    flex-flow: column;
    overflow: hidden;
    justify-content: space-evenly;
    height: var(--size);
    width: var(--size);
    transition: 0.2s ease-in-out transform;
    position: relative;
  }

  .menu-button:active {
    transform: scale(0.95);
  }

  .menu-button__line {
    height: 3px;
    border-radius: 2px;
    width: 100%;
    background-color: var(--color-base-800);
    transition:
      0.2s ease-in-out transform,
      0.32s ease-in-out background-color;
    transform-origin: center;
    display: block;
  }

  .menu-button:hover > .menu-button__line {
    background-color: var(--color-brand-300);
  }

  .menu-button[data-open-menu="true"] > .menu-button__line:nth-of-type(1) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .menu-button[data-open-menu="true"] > .menu-button__line:nth-of-type(3) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .menu-button[data-open-menu="true"] > .menu-button__line:nth-of-type(2) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(0);
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  button?.addEventListener("click", () => {
    const isOpen = button.dataset.openMenu === "true";
    button.dataset.openMenu = String(!isOpen);
    button.setAttribute("aria-expanded", String(!isOpen));
    button.setAttribute("aria-label", isOpen ? "Otwórz menu" : "Zamknij menu");
  });
</script>
