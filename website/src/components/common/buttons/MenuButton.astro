<button
  :aria-expanded="$store.navigation.open"
  :aria-label="$store.navigation.open ? 'Zamknij menu' : 'Otwórz menu'"
  :data-open-menu="$store.navigation.open"
  @click="$store.navigation.toggle()"
  class="menu-button"
>
  <span class="line"></span>
  <span class="line"></span>
</button>

<style>
  .menu-button {
    --color:var(--color-neutral-800);
    --line:4px;
    --size: 4.45rem;
    display: flex;
    flex-flow: column;
    flex-shrink: 0;
    height: var(--size);
    justify-content: space-evenly;
    /* overflow: hidden; */
    padding: 0.15rem;
    position: relative;
    transition: var(--easing) transform;
    width: var(--size);
    
    &:active {
      transform: scale(0.95);
    }
  }


  .line {
    background-color: var(--color);
    border-radius: 2px;
    display: block;
    height: var(--line);
    transform-origin: center;
    transition:
      var(--easing) transform,
      var(--easing) background-color;
    width: 100%;
  }

  .menu-button[data-open-menu=true] > .line {
    left: 50%;
    position: absolute;
    top: 50%;
  }

  .menu-button[data-open-menu="true"] > .line:nth-of-type(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .menu-button[data-open-menu="true"] > .line:nth-of-type(2) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .line ,
    .menu-button {
      transition: none;
    }
  }

</style>
