---
import ArrowRight from "@icons/ArrowRight.astro";
import type { CallToAction } from "@ts/navigation.types";
interface Props extends CallToAction {
  variant: "mobile" | "desktop";
}
const { label, uri, variant } = Astro.props;
---

<a class="cta" data-variant={variant} href={uri} @click="$store.navigation.close()" >
  <span class="text">{label}</span>
  <span aria-hidden="true" class="arrow">
    <ArrowRight class="icon" />
  </span>
</a>

<style>

.cta {
  --arrow-bg:var(--color-brand-400);
  --arrow-color:var(--color-neutral-100);
  --arrow-rounded:0 var(--rounded) var(--rounded) 0;
  --arrow-size:calc( calc(var(--label-pad-y) * 2) + var(--label-size) );
  --gap:0 .35rem;
  --chevron-size:55%;
  --label-bg:var(--color-neutral-100);
  --label-color:var(--color-neutral-1100);
  --label-size:2rem;
  --label-pad:var(--label-pad-y) 0 var(--label-pad-y) var(--label-pad-x);
  --label-pad-x:3rem;
  --label-pad-y:2rem;
  --label-rounded:var(--rounded) 0 0 var(--rounded);
  --rounded:1rem;
  flex-flow:row nowrap;
  gap:var(--gap);
  justify-content: flex-end;
  transition:var(--easing) gap;
  &:is(:hover,:focus-visible,:focus,:focus-within){
    --gap:0rem;
    --arrow-bg:var(--color-accent-100);
    & > .arrow {
      border-radius: var(--arrow-rounded);
    }
    & > .text {
      border-radius: var(--label-rounded);
    }
  }
  &,
  & > * {
    align-items: center;
    display: flex;
  }
  &,
  & > .text {
    width: 100%;
  }
  :global(.chevron) {
    fill: var(--arrow-color);
    height: var(--chevron-size);
    margin:auto;
    width: var(--chevron-size) ;
  }
  & > .text {
    background-color: var(--label-bg);
    border-radius: var(--rounded);
    color: var(--label-color);
    font-family: var(--font-display);
    font-size: var(--label-size);
    font-weight: 800;
    height: 100%;
    justify-content: flex-start;
    padding:var(--label-pad);
    text-transform: uppercase;
    transition: var(--easing) border-radius;
  }
  & > .arrow {
    background-color: var(--arrow-bg);
    border-radius: var(--rounded);
    height: var(--arrow-size);
    justify-content: center;
    transition:var(--easing) background-color, var(--easing) border-radius;
    width: var(--arrow-size);
    & >* {
      align-items: center; 
      display: flex;
      height: 100%;
      justify-content: center;
      transform: scale(.8);
    }
  }
}
.cta[data-variant="mobile"]{
  --label-size:2.5rem;
  --label-pad-x:2rem;
  margin-top: 5rem;
}
.cta[data-variant="desktop"]{
  --label-bg:var(--color-neutral-1100);
  --label-color:var(--color-neutral-100);
  --label-size:1.9rem;
  --label-pad-x:2rem;
}
 @media (width >= 1100px){  
    .cta[data-variant="mobile"] {
      display: none;
    }
    
 }
</style>
