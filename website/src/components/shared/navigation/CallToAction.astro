---
import ArrowRight from "@icons/ArrowRight.astro";
import type { CallToAction } from "@ts/navigation.types";
interface Props extends CallToAction {
  variant: "mobile" | "desktop";
}
const { label, uri, variant } = Astro.props;
---

<a class="cta" data-variant={variant} href={uri}>
  <span class="text">{label}</span>
  <span aria-hidden="true" class="arrow">
    <ArrowRight class="icon" />
  </span>
</a>

<style>
  .cta {
    --animation: 0.25s ease-in-out;
    --label-bg: var(--color-base-1300);
    --label-color: var(--color-base-200);
    --label-size: 2.15rem;
    --icon-size: 4.45rem;
    --icon-bg: var(--color-brand-400);
    --icon-bg-hover: var(--color-support-200);
    --padding: 1.12rem 0 1.12rem 1.75rem;
    --margin: auto;
    --height: 5rem;
    align-items: center;
    display: inline-flex;
    justify-content: space-between;
    margin: var(--margin);
    & > .arrow {
      align-items: center;
      aspect-ratio: 1;
      background-color: var(--icon-bg);
      display: flex;
      height: 100%;
      justify-content: center;
      transition: var(--animation) background-color;
      & > .icon {
        height: var(--icon-size);
        width: var(--icon-size);
      }
    }
    & > .text {
      color: var(--label-color);
      font: 700 var(--label-size) / 1 var(--font-headings);
      padding: var(--padding);
      text-transform: uppercase;
    }
    &:hover > .arrow {
      background-color: var(--icon-bg-hover);
    }
    &:hover > .arrow > .icon > :global(.chevron) {
      fill: var(--color-base-1000);
    }
  }

  :global(.chevron) {
    fill: var(--color-base-100);
    transition: var(--animation) fill;
  }

  .cta[data-variant="mobile"] {
    --margin: auto auto 0 auto;
    background-color: var(--label-bg);
    width: 100%;
  }
  .cta[data-variant="desktop"] {
    --label-size: 2rem;
    --icon-size: 70%;
    --padding: 0 1.5rem;
    --margin: auto unset;
    height: var(--height);
    max-width: 100%;
    & > .arrow,
    & > .text {
      border-radius: 0.75rem;
      corner-shape: scoop;
      flex-shirnk: 0;
      overflow: hidden;
    }
    & > .arrow {
      margin-left: 0.25rem;
    }
    & > .text {
      align-items: center;
      display: flex;
      justify-content: center;
      background-color: var(--label-bg);
      height: 100%;
    }
  }

  @media (width > 600px) {
    .cta[data-variant="mobile"] {
      --label-size: 2.75rem;
      --icon-size: 6.25rem;
      --padding: 1.42rem 0 1.42rem 1.75rem;
    }
  }
  @media (width > 1049px) {
    .cta[data-variant="mobile"] {
      display: none;
    }
  }

  @media (width > 1494px) {
    .cta[data-variant="desktop"] {
      --label-size: 2.4rem;
      --height: 5.6rem;
      --icon-size: 85%;
      --padding: 0 2.85rem;
    }
  }
</style>
