---
import Logo from "@icons/Logo.astro";

interface Props {
  brand: string;
  uri: string;
}

const { brand, uri } = Astro.props;
---

<a @click="$store.navigation.close()" class="brand" href={uri}>
  <Logo class="logo" />
  <span class="title">Adamczyk<span class="special">TOP</span></span>
</a>

<style>
  .brand {
    --label-size:clamp(2rem, calc(2.2rem + 1.85vw), 3.25rem);
    --logo-size:clamp(2rem, calc(2.2rem + 1.85vw), 3.25rem);
    --special:var(--color-brand-400);
    align-items: center;
    display: flex;
    justify-content: flex-start;
  }
  .logo {
    height: var(--logo-size);
    width: var(--logo-size);
  }
  .title {
    font-size: var(--label-size);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .special {
    color:var(--special);
  }
</style>
