---
import Logo from "@icons/Logo.astro";

interface Props {
  brand: string;
  uri: string;
}

const { brand, uri } = Astro.props;
---

<a
  @click="$store.navigation.close()"
  :data-expanded="$store.navigation.open"
  class="brand"
  x-data
  href={uri}
>
  <Logo class="logo" />
  <span class="title">ADAMCZYKTOP</span>
  <!-- <span class="brand__title">Leagcy</span> -->
</a>

<style>
  .brand {
    align-items: center;
    display: inline-flex;
    gap: 3.5px;
  }

  .logo {
    --size: 4.05rem;
    flex-shrink: 0;
    height: var(--size);
    width: var(--size);
  }
  .title {
    --size: 3.05rem;
    letter-spacing: 1.5px;
    color: var(--color-base-1100);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--size);
  }

  @media (width > 600px) {
    .title {
      --size: 3.35rem;
    }
    .logo {
      --size: 4.45rem;
    }
  }

  @media (width > 1049px) {
    .title {
      --size: 2.35rem;
    }
    .logo {
      --size: 2.45rem;
    }
  }
  @media (width > 1494px) {
    .title {
      --size: 3.25rem;
    }
    .logo {
      --size: 3.75rem;
    }
  }
</style>
