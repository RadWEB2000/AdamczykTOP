---
import Logo from "@icons/Logo.astro";

interface Props {
  brand: string;
  uri: string;
}

const { brand, uri } = Astro.props;
---

<a
  @click="$store.navigation.close()"
  :data-expanded="$store.navigation.open"
  class="brand"
  x-data
  href={uri}
>
  <Logo class="brand__logo" />
  <span class="brand__title">{brand}</span>
</a>

<style>
  .brand {
    align-items: center;
    display: inline-flex;
    gap: 3.5px;
  }

  .brand__logo {
    --size: 3.45rem;
    flex-shrink: 0;
    height: var(--size);
    width: var(--size);
  }
  .brand__title {
    --size: 2.65rem;
    color: var(--color-base-1100);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--size);
  }
</style>
