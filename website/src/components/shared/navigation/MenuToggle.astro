---
import ChevronDown from "@icons/ChevronDown.astro";
import { MenuItem as Item } from "@shared/navigation";
import type { NavigationMenuLink } from "@ts/navigation.types";

interface Props extends Omit<NavigationMenuLink, "order"> {
  panelId?: string;
}

const { panelId, ...link } = Astro.props;
---

<div class="menu-toggle">
  <Item {...link} variant="main-toggle" />
  <button
  :aria-expanded={`activeMenu === ${JSON.stringify(panelId)}`}
  @click={`toggleMenu(${JSON.stringify(panelId)})`}
  aria-controls={panelId}
  aria-label="Rozwiń lub zwiń podmenu"
  :data-expanded={`activeMenu === ${JSON.stringify(panelId)}`}
  class="button"
  type="button"
  >
  <ChevronDown class="icon" />
</button>
</div>

<style>
  .menu-toggle {
    --icon:var(--color-neutral-200);
    --size:4rem;
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0,1fr) var(--size);
    gap:0 2rem;
    flex-flow:row nowrap;
    width: 100%;
  }
  .button {
    align-items: center;
    background-color: var(--color-neutral-1100);
    border-radius: .75rem;
    padding: 0.45rem;
    display: flex;
    justify-content: center;
    height: var(--size);
    width: var(--size);
    
    &[data-expanded=true]{
      --icon:var(--color-neutral-1100);
      background-color: var(--color-accent-100);
      .icon {
        transform: rotate(90deg);
      }
    }
  }
  .icon {
    fill: var(--icon);
    transition:var(--easing) transform, var(--easing) fill;
  }
  @media (width >= 1100px){  
    .menu-toggle {
      --size:3rem;
      border-bottom: 0;
      gap:0 1rem;
       width: auto;
      display: flex;
      /* background: aquamarine; */
    }
 }
</style>
