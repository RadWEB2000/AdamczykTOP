---
import ChevronDown from "@icons/ChevronDown.astro";
import { MenuItem as Item } from "@shared/navigation";
import type { NavigationMenuLink } from "@ts/navigation.types";

interface Props extends Omit<NavigationMenuLink, "order"> {
  panelId: string;
}

const { panelId, ...link } = Astro.props;
const id = JSON.stringify(panelId);
---

<div class="menu-toggle">
  <Item {...link} variant="main-toggle" />
  <button
    :aria-expanded={`$store.navigation.isMenuOpen(${id})`}
    :data-expanded={`$store.navigation.isMenuOpen(${id})`}
    @click={`$store.navigation.toggleMenu(${id})`}
    aria-controls={panelId}
    aria-label={`Rozwiń lub zwiń podmenu: ${link.label}`}
    class="button"
    type="button"
  >
    <ChevronDown class="icon" />
  </button>
</div>

<style>
  .menu-toggle {
    --button-bg:var(--color-neutral-1100);
    --button-color:var(--color-neutral-200);
    --button-size:4rem;
    --columns: minmax(0,1fr) var(--button-size);
    --display:grid;
    --gap:0 2rem;
    --rotate:0deg;
    --radius:.75rem;
    --width:100%;
    align-items: center;
    display: var(--display);
    grid-template-columns:var(--columns);
    gap:var(--gap);
    flex-flow:row nowrap;
    width:var(--width);
    & > .button {
      align-items: center;
      background-color: var(--button-bg);
      border-radius:var(--radius);
      display: flex;
      height: var(--button-size);
      justify-content: center;
      padding: 0.45rem;
      width: var(--button-size);
      &[data-expanded=true]{
        --button-bg:var(--color-accent-100);
        --button-color:var(--color-neutral-1100);
        --rotate:90deg;
      }
      & > .icon {
        fill: var(--button-color);
        transform: rotate(var(--rotate));
        transition:var(--easing) transform, var(--easing) fill;
      }
    }
  }
  
  @media (width >= 1100px){  
    .menu-toggle {
      --button-size:3rem;
      --display:flex;
      --gap:0 .25rem;
      --width:auto;
    }
 }
 @media (prefers-reduced-motion: reduce){
  .menu-toggle {
    .button,
    .icon {
      transition: none;
    }
  }
 }
</style>
