---
import {
  MenuItem as Item,
  MenuDropdown as Dropdown,
  CallToAction as CTA,
  MenuMega as Mega,
} from "@shared/navigation";

import type { CallToAction, NavigaitonMenuItem } from "@ts/navigation.types";
interface Props {
  menu: Array<NavigaitonMenuItem>;
  callToAction: CallToAction;
}

const { menu, callToAction } = Astro.props;
---

<menu
  class="menu"
>
  {
    menu.map((item) => {
      switch (item.type) {
        case "dropdown":
          return <Dropdown {...item} />;
        case "mega":
          return <Mega {...item} />;
        default:
          return <Item {...item} variant="main" />;
      }
    })
  }
  <CTA {...callToAction} variant="mobile" />
</menu>

<style>
  .menu {
    --align:start;
    --direction:column;
    --gap:0;
    --justify:flex-start;
    --overflow:scroll;
    --padding:3rem 1rem;
    align-items:var(--align);
    display: flex;
    gap:var(--gap);
    justify-content: var(--justify);
    flex-flow:var(--direction);
    height: 100%;
    overflow-y: var(--overflow);
    padding: var(--padding);
    scrollbar-width: 0px;
    &::-webkit-scrollbar {
      width: 0;
    }
    & > :global(*){
      flex-shrink: 0;
    }
  }
  @media (width >= 1100px){ 
    .menu {
      --align:center;
      --direction:row nowrap;
      --justify:flex-end;
      --overflow:visible;
      --gap:0 .75rem;
    }
  }
  @media (width >= 1600px){ 
    .menu {
      --gap:0 1.25rem;
    }
  }
</style>
