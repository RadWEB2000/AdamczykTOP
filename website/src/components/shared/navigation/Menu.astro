---
import {
  MenuItem as Item,
  MenuDropdown as Dropdown,
  CallToAction as CTA,
  MenuMega as Mega,
} from "@shared/navigation";
import type { CallToAction, NavigaitonMenuItem } from "@ts/navigation.types";
interface Props {
  menu: Array<NavigaitonMenuItem>;
  callToAction: CallToAction;
}

const { menu, callToAction } = Astro.props;
---

<menu
  class="menu"
  x-data="{
    activeMenu: null,
    closeTimer: null,

    openMenu(id) {
      clearTimeout(this.closeTimer);
      this.activeMenu = id;
    },

    closeMenu(id) {
      clearTimeout(this.closeTimer);

      this.closeTimer = setTimeout(() => {
        if (this.activeMenu === id) {
          this.activeMenu = null;
        }
      }, 150);
    },

    cancelClose() {
      clearTimeout(this.closeTimer);
    },

    toggleMenu(id) {
      clearTimeout(this.closeTimer);
      this.activeMenu = this.activeMenu === id ? null : id;
    }
  }"
>
  {
    menu.map((item) => {
      switch (item.type) {
        case "dropdown":
          return <Dropdown {...item} />;
        case "mega":
          return <Mega {...item} />;
        default:
          return <Item {...item} variant="main" />;
      }
    })
  }
  <CTA {...callToAction} variant="mobile" />
</menu>

<style>
  .menu {
    /* --gap:2rem; */
    --padding:3rem 1rem;
    align-items: start;
    display: flex;
    justify-content: flex-start;
    flex-flow:column;
    overflow-y: scroll;
    height: 100%;
    padding: var(--padding);
    /* background: gray; */
    scrollbar-width: 0px;
  }

  .menu::-webkit-scrollbar {
    width: 0;
  }


  @media (width >= 1100px){ 
    .menu {
      align-items: center;
      justify-content: flex-end;
      flex-flow:row nowrap;
      overflow: visible;
      gap:0 .75rem;
    }
  }
</style>
