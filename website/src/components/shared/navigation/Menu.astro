---
import {
  MenuItem as Item,
  MenuDropdown as Dropdown,
  CallToAction as CTA,
  MenuMega as Mega,
} from "@shared/navigation";
import type { CallToAction, NavigaitonMenuItem } from "@ts/navigation.types";
interface Props {
  menu: Array<NavigaitonMenuItem>;
  callToAction: CallToAction;
}

const { menu, callToAction } = Astro.props;
---

<menu
  class="menu"
  x-data="{
    activeMenu: null,
    closeTimer: null,

    openMenu(id) {
      clearTimeout(this.closeTimer);
      this.activeMenu = id;
    },

    closeMenu(id) {
      clearTimeout(this.closeTimer);

      this.closeTimer = setTimeout(() => {
        if (this.activeMenu === id) {
          this.activeMenu = null;
        }
      }, 150);
    },

    cancelClose() {
      clearTimeout(this.closeTimer);
    },

    toggleMenu(id) {
      clearTimeout(this.closeTimer);
      this.activeMenu = this.activeMenu === id ? null : id;
    }
  }"
>
  {
    menu.map((item) => {
      switch (item.type) {
        case "dropdown":
          return <Dropdown {...item} />;
        case "mega":
          return <Mega {...item} />;
        default:
          return <Item {...item} variant="main" />;
      }
    })
  }
  <CTA {...callToAction} variant="mobile" />
</menu>

<style>
  .menu {
    align-items: flex-start;
    display: flex;
    flex-flow: column;
    height: 100%;
    gap: 17px 0;
    overflow-y: scroll;
    padding: 2rem;
    scrollbar-width: none;
    width: 100%;
  }
  @media (width > 600px) {
    .menu {
      padding: 2rem 3rem;
    }
  }
  @media (width > 1049px) {
    .menu {
      /* background: pink; */
      align-items: center;
      flex-flow: row;
      justify-content: flex-end;
      gap: 0 10px;
      padding: 0;
      overflow-y: visible;
    }
  }
</style>
