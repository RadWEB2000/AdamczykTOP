---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";

interface Props extends Omit<NavigationMenuLink, "order"> {
  items: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
    }
  >;
}

const { items, ...link } = Astro.props;

const panelId = `dropdown-${crypto.randomUUID()}`;

const id = JSON.stringify(panelId);

const hoverSupported =
  "window.matchMedia('(hover: hover) and (pointer: fine)').matches";
---

<div
  class="menu-dropdown"
  x-data="{expanded:false}"
  @mouseenter={`if (${hoverSupported}) openMenu(${id})`}
  @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
>
  <Toggle panelId={panelId} {...link} />
  <div
    class="dropdown"
    @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
    :data-expanded={`activeMenu === ${id}`}
    :inert={`activeMenu !== ${id}`}
  >
    <div class="items">
      {
        items.map((item) => {
          return <Item {...item} variant="dropdown" />;
        })
      }
    </div>
  </div>
</div>

<style>
  .menu-dropdown {
    width: 100%;
  }
  .dropdown {
    --rows: 0fr;
    display: grid;
    grid-template-rows: var(--rows);
    overflow: hidden;
    transition: 0.15s ease-in-out grid-template-rows;
  }

  .dropdown[data-expanded="true"] {
    --rows: 1fr;
  }

  .items {
    display: flex;
    flex-flow: column;
    gap: 5px 0;
    min-height: 0;
    overflow: hidden;
    padding-top: 1rem;
  }
  @media (width > 1049px) {
    .menu-dropdown {
      /* background: salmon; */
      position: relative;
      position: static;
      width: fit-content;
    }

    .dropdown {
      position: absolute;
      display: block;
      background: var(--color-base-200);
      corner-shape: scoop;
      box-shadow: 0 0 1px 1.5px --transparentColor(var(--color-base-1300), 0.85);
      border-radius: 1rem;
      width: max(100px, 350px);
      opacity: 0;
      visibility: hidden;
      transition:
        0.15s ease-in-out opacity,
        0.15s ease-in-out transform,
        0.15s ease-in-out visibility;
      transform: translateY(0) scaleY(1);
      transform-origin: top;
      right: 0;
      top: 100%;
    }

    .dropdown[data-expanded="true"] {
      transform: translateY(0) scaleY(1);
      opacity: 1;
      visibility: visible;
      transition:
        0.1s ease-in-out opacity,
        0.1s ease-in-out transform,
        0.1s ease-in-out visibility;
    }
    .items {
      padding: 3rem;
      gap: 2.8rem;
    }
  }
</style>
