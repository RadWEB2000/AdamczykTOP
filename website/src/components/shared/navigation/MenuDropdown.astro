---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";

interface Props extends Omit<NavigationMenuLink, "order"> {
  items: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
    }
  >;
}
const { items, ...link } = Astro.props;
const panelId = `dropdown-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
const hoverSupported =
  "window.matchMedia('(hover: hover) and (pointer: fine)').matches";
---

<div
  class="menu-dropdown"
  @mouseenter={`if (${hoverSupported}) openMenu(${id})`}
  @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
>
  <Toggle panelId={panelId} {...link} />
  <div
    class="dropdown"
    :data-expanded={`activeMenu === ${id}`}
    :inert={`activeMenu !== ${id}`}
  >
    <div class="items">
      {
        items.map((item) => {
          return <Item {...item} variant="dropdown" />;
        })
      }
    </div>
  </div>
</div>

<style>
  .menu-dropdown {
    --animation:.17s ease-in-out;
    --background:var(--color-base-200);
    --dropdown: clamp(10rem, 25vw, 30rem);
    --gap:5px 0;
    --padding:1rem 0 0 0;
    --rows: 0fr;
    --shadow:0 0 1px 1.5px --transparentColor(var(--color-base-1300), 0.85);
    --width:100%;
    width:var(--width);
  }
  .dropdown {
    display: grid;
    grid-template-rows: var(--rows);
    overflow: hidden;
    transition: var(--animation) grid-template-rows;
    &[data-expanded=true]{
      --rows:1fr;
    }
  }
  .items {
    display: flex;
    flex-flow: column;
    gap: var(--gap);
    min-height: 0;
    overflow: hidden;
    padding: var(--padding);
  }
  @media (width > 1049px) {
    .menu-dropdown {
      --padding:3rem;
      --gap:2.8rem 0;
      --width:fit-content;
      position: static;
    }
    .dropdown {
      background: var(--background);
      border-radius: 1rem;
      box-shadow: var(--shadow);
      corner-shape: scoop;
      display: block;
      opacity: 0;
      position: absolute;
      right: 0;
      top: 100%;
      transform: translateY(0.5rem);
      transform-origin: top;
      transition:
        var(--animation) opacity,
        var(--animation) transform,
        var(--animation) visibility;
      visibility: hidden;
      width:var(--dropdown);
      &[data-expanded="true"] {
        opacity: 1;
        transform: translateY(0);
        visibility: visible;
      }
    }

  }
</style>
