---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";

interface Props extends Omit<NavigationMenuLink, "order"> {
  items: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
    }
  >;
}
const { items, ...link } = Astro.props;
const panelId = `dropdown-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
---

<div
  @mouseenter={`$store.navigation.onMenuEnter(${id})`}
  @mouseleave={`$store.navigation.onMenuLeave(${id})`}
  class="menu-dropdown"
>
  <Toggle panelId={panelId} {...link} />
  <div
    :data-expanded={`$store.navigation.isMenuOpen(${id})`}
    :inert={`!$store.navigation.isMenuOpen(${id})`}
    class="dropdown"
    id={panelId}
  >
    <div class="items">
      {
        items.map((item) => {
          return <Item {...item} variant="dropdown" />;
        })
      }
    </div>
  </div>
</div>

<style>
  .menu-dropdown {
    --border:1px solid --transparentColor(var(--color-neutral-900),.25);
    --dropdown-bg:transparent;
    --dropdown-display:grid;
    --dropdown-overflow:hidden;
    --dropdown-position:static;
    --dropdown-rows:0fr;
    --dropdown-width:100%;
    --gap:1.15rem 0;
    --item-pad:0 .25rem;
    --opacity:1;
    --overflow:hidden;
    --radius:0;
    --translate:0;
    --width:100%;
    border-bottom:var(--border);
    width: var(--width);
    & > .dropdown {
      background-color: var(--dropdown-bg);
      border-radius: var(--radius);
      display: var(--dropdown-display);
      grid-template-rows:var(--dropdown-rows);
      opacity: var(--opacity);
      position: var(--dropdown-position);
      transform: translateY(var(--translate));
      transition: var(--easing) grid-template-rows, var(--easing) opacity, var(--easing) transform;
      visibility: visible;
      width: var(--dropdown-width);
      &[data-expanded=true]{
        --dropdown-rows:1fr;
        --items-pad:.5rem .25rem 3.5rem .25rem;
      }
      & > .items {
        align-items: start;
        display: flex;
        flex-flow:column;
        gap:var(--gap);
        justify-content: flex-start;
        min-height: 0;
        overflow: var(--overflow);
        padding: var(--items-pad);
        transition: var(--easing) padding;
      }
    }
  }
  @media (width >= 1100px){  
    .menu-dropdown {
      --border:0;
      --dropdown-bg:var(--color-neutral-200);
      --dropdown-display:block;
      --dropdown-overflow:visible;
      --dropdown-position:absolute;
      --dropdown-rows:1fr;
      --dropdown-width:min(275px,100%);
      --items-pad:2rem;
      --opacity:0;
      --radius:0 0 1rem 1rem;
      --translate:-8px;
      --width:auto;
      & > .dropdown {
        right: 0;
        &[data-expanded=true]{
          --items-pad:2rem;
          --opacity:1;
          --translate:0;
        }
        & > .items {
          transition: none;
        }
      }
    }
 }
 @media (prefers-reduced-motion: reduce){
  .dropdown,
  .items {
    transition: none;
  }
 }
</style>
