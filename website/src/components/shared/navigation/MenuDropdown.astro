---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";

interface Props extends Omit<NavigationMenuLink, "order"> {
  items: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
    }
  >;
}
const { items, ...link } = Astro.props;
const panelId = `dropdown-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
const hoverSupported =
  "window.matchMedia('(hover: hover) and (pointer: fine)').matches";
---

<div
  class="menu-dropdown"
  @mouseenter={`if (${hoverSupported}) openMenu(${id})`}
  @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
>
  <Toggle panelId={panelId} {...link} />
  <div
    class="dropdown"
    :data-expanded={`activeMenu === ${id}`}
    :inert={`activeMenu !== ${id}`}
  >
  <!-- <div
    class="dropdown"
    :data-expanded={`true`}
    :inert={`true`}
  > -->
    <div class="items">
      {
        items.map((item) => {
          return <Item {...item} variant="dropdown" />;
        })
      }
    </div>
  </div>
</div>

<style>
  .menu-dropdown {
    /* background: purple; */
    width: 100%;
    border-bottom: 1px solid --transparentColor(var(--color-neutral-900),.25);
    /* position: relative; */
  }

  .dropdown {
    display: grid;
    overflow: hidden;
    grid-template-rows:0fr;
    transition: var(--easing) grid-template-rows;
    /* display: none; */
    &[data-expanded=true]{
      grid-template-rows:1fr;
      .items {
        padding:.5rem .25rem 3.5rem .25rem;
      }
    }
  }
  .items {
    align-items: start;
    display: flex;
    min-height: 0px;
    overflow: hidden;
    gap:1.15rem 0;
    justify-content: flex-start;
    flex-flow:column;
    padding: 0 .25rem;
    transition: var(--easing) padding;
  }
  @media (width >= 1100px){  
    .menu-dropdown {
      border-bottom: 0;
      width: auto;
    }
    .dropdown {
      background-color: var(--color-neutral-200);
      opacity: 0;
      transform-origin: top;
      transform:translateY(-12px);
      position: absolute;
      transition: var(--easing) height, var(--easing) opacity, var(--easing) transform;
      border-radius:0 0 1rem 1rem;
      overflow: visible;
      display: block;
      right: 0;
      width: 275px;
       &[data-expanded="true"]{
          opacity: 1;transform:translateY(0);
          .items {
            padding: 2rem;
          }    
        }
    }
    .items {
padding: 2rem;
    }
 }
</style>
