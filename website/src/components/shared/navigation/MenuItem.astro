---
interface Props {
  label: string;
  uri: string;
  description?: string;
  variant: "main"| "main-toggle" | "mega" | "mega-item" | "dropdown";
}
const { label, uri, description, variant = "main" } = Astro.props;
---

<a
  class="menu-item"
  data-variant={variant}
  href={uri}
  @click="$store.navigation.close()"
>
  <span class="label">
    {label}
  </span>
  {description && <span class="description">{description}</span>}
</a>

<style>
  .menu-item,
  .menu-item > * {
    display: block;
  }

  .menu-item {
    font-family: var(--font-display);
  }

  .menu-item[data-variant="main"] {
    /* background: orange; */
    width: 100%;
    border-bottom: 1px solid --transparentColor(var(--color-neutral-900),.25);
    
  }

  .menu-item[data-variant="main"],
  .menu-item[data-variant="main-toggle"]{
    --label-size:clamp(2rem, calc(2rem + 1.8vw), 3.5rem);
    color:var(--color-neutral-900);
    padding: 1.5rem .75rem;
    text-transform: uppercase;
    font-weight: 600;
    font-size: var(--label-size);
  }

  .menu-item[data-variant="mega"]{
    --label-size:clamp(1.75rem, calc(1.65rem + 1.8vw), 2.15rem);
    --description-size:clamp(1.4rem, calc(1.3rem + .7vw), 1.815rem);
    margin-bottom: 1rem;
    /* background-color: --transparentColor(var(--color-neutral-400),.45); */
    background-color: color-mix(in srgb, var(--color-brand-100) 33%,var(--color-neutral-200));
    padding: 1.7rem;
    border-radius: 1rem;
      .label {
        color:var(--color-neutral-1000);
        font-size: var(--label-size);
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: .65rem;
      }
      .description {
        color:var(--color-neutral-800);
        font-size: var(--description-size);
        font-family: var(--font-body);
        text-wrap: balance;
      }
  }
  .menu-item[data-variant="mega-item"]{
    --label-size:clamp(1.55rem, calc(1.35rem + 1.1vw), 1.72rem);
    .label {
      color:var(--color-neutral-700);
      font-size: var(--label-size);
      text-transform: uppercase;
    }
  }

  .menu-item[data-variant="dropdown"]{
       --label-size:clamp(1.75rem, calc(1.35rem + 1.2vw), 1.95rem);
    --description-size:clamp(1.4rem, calc(1.3rem + .7vw), 1.515rem);
    background-color: color-mix(in srgb, var(--color-brand-100) 33%,var(--color-neutral-200));
    width: 100%;
    border-radius: 0.75rem;
    padding: 1.7rem;
       .label {
        color:var(--color-neutral-1000);
        font-size: var(--label-size);
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: .65rem;
      }
      .description {
        color:var(--color-neutral-800);
        font-size: var(--description-size);
        font-family: var(--font-body);
        text-wrap: balance;
      }
  }
  @media (width >= 1100px){  
    .menu-item[data-variant="main"]{
      border-bottom: 0;
      width: auto;
    }

    .menu-item[data-variant="main"],
    .menu-item[data-variant="main-toggle"]{
      padding: 1rem 0rem;
      font-size: 2rem;
    }
  } 
</style>
