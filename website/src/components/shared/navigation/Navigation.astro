---
import { navigation } from "@static/navigation";
import { MenuButton } from "@common/buttons";
import { Brand, CallToAction, Menu } from "@shared/navigation";
const { brand, menu, callToAction } = navigation;
---

<div
  x-data
  class="navigation"
  :data-expanded="$store.navigation.open"
  :data-scrolled="$store.navigation.scrolled"
>
  <div x-data class="container" :data-expanded="true">
    <nav class="inner">
      <div class="brand">
        <Brand brand={brand} uri="/" />
      </div>
      <div class="menu">
        <Menu
          menu={[...menu].sort((a, b) => a.order - b.order)}
          callToAction={callToAction}
        />
      </div>
      <div class="settings">
        <MenuButton />
      </div>
    </nav>
    <div class="cta">
      <CallToAction {...callToAction} variant="desktop" />
    </div>
  </div>

  <style>
    .navigation {
      --animation: 0.25s ease-in-out;
      --background: var(--color-base-200);
      --container-columns: minmax(0, 1fr) var(--cta-width);
      --cta-width: 21rem;
      --inner-columns: calc(100% - var(--settings-width)) var(--settings-width);
      --inner-shadow: 0 0 1px 1.5px
        --transparentColor(var(--color-base-1300), 0.85);
      --inner-rows: var(--menu-content-height) 0;
      --menu-content-height: 6.95rem;
      --nav-top: 0;
      --nav-width: 100%;
      --settings-width: 7.5rem;
      --shadow-nav: 0 0 1px 1.5px var(--color-base-1300);
      --spacing: 2rem;
      isolation: isolate;
      left: 0;
      position: fixed;
      top: var(--nav-top);
      transition: var(--animation) box-shadow;
      width: var(--nav-width);
      z-index: 99;
      &[data-expanded="true"] {
        --inner-rows: var(--menu-content-height)
          calc(100vh - var(--menu-content-height));
      }
    }
    .navigation[data-scrolled="true"]:not([data-expanded="true"]) {
      box-shadow: var(--shadow-nav);
    }
    .cta {
      align-items: center;
      display: none;
      justify-content: flex-end;
      padding-right: var(--spacing);
    }
    .container {
      anchor-name: --navigation-container;
      background-color: var(--background);
      display: grid;
      margin: 0 auto;
      overflow: hidden;
      position: relative;
    }
    .inner {
      background-color: var(--background);
      display: grid;
      grid-template-columns: var(--inner-columns);
      grid-template-rows: var(--inner-rows);
      position: relative;
      transition: var(--animation) grid-template-rows;
    }
    .brand,
    .settings {
      align-items: center;
      display: flex;
    }
    .brand {
      grid-column: 1;
      grid-row: 1;
      justify-content: flex-start;
      padding-left: var(--spacing);
    }
    .menu {
      grid-column: 1/-1;
      grid-row: 2;
    }
    .settings {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      padding-right: var(--spacing);
    }
    @media (width > 600px) {
      .navigation {
        --spacing: 2.5rem;
        --menu-content-height: 7.25rem;
      }
    }
    @media (width > 1049px) {
      .navigation {
        --inner-columns: 1.5fr 4.5fr;
        --inner-rows: var(--menu-content-height);
        --nav-top: 1rem;
        --nav-width: min(1920px, 97%);
        --spacing: 3.5rem;
        left: 50%;
        transform: translateX(-50%);
        &[data-expanded="true"] {
          --inner-rows: var(--menu-content-height);
        }
        &[data-scrolled="true"]:not([data-expanded="true"]) {
          box-shadow: 0 0 0 1.5px transparent;
        }
      }
      .cta {
        display: flex;
      }
      .container {
        background-color: transparent;
        grid-template-columns: var(--container-columns);
        gap: 0 1rem;
        overflow: visible;
      }

      .inner {
        box-shadow: var(--inner-shadow);
        border-radius: 1rem;
        corner-shape: scoop;
      }

      .menu {
        padding-right: var(--spacing);
        grid-column: 2/-1;
        grid-row: 1;
      }
      .settings {
        display: none;
      }
    }
    @media (width > 1494px) {
      .navigation {
        --nav-width: min(1920px, 97%);
        --spacing: 3.5rem;
        --cta-width: 27rem;
      }
    }
  </style>
</div>
