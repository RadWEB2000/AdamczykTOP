---
import { navigation } from "@static/navigation";
import { MenuButton } from "@common/buttons";
import { Brand, CallToAction, Menu } from "@shared/navigation";
const { brand, menu, callToAction } = navigation;
---

<div
x-data
class="navigation"
:data-expanded="$store.navigation.isOpen"
:data-scrolled="$store.navigation.isScrolled"
transition:persist="main-navigation"
>
  <div x-data class="container" :data-expanded="true">
    <nav class="inner">
      <div class="brand">
        <Brand brand={brand} uri="/" />
      </div>
      <div class="menu">
        <Menu
        menu={[...menu].sort((a, b) => a.order - b.order)}
        callToAction={callToAction}
        />
      </div>
      <div class="settings">
        <MenuButton />
      </div>
    </nav>
    <div class="cta">
      <CallToAction {...callToAction} variant="desktop" />
    </div>
  </div>
</div>
<style>
  .navigation {
    --container-cols:minmax(0,1fr) 15rem;
    --container-width:100%;
    --cta-visibility:none;
    --inner-bg:var(--color-neutral-200);
    --inner-cols:minmax(0,1fr) 10rem;
    --inner-height:7.5rem;
    --inner-rows:var(--inner-height) 0px;
    --nav-bg:var(--inner-bg);
    --overflow:hidden;
    --radius:2rem;
    --settings-visibility:flex;
    --spacing:1.75rem;
    --top:0;
    background-color:var(--nav-bg);
    left: 0;
    position: fixed;
    top: var(--top);
    transition: var(--easing) background-color;
    width: 100%;
    &[data-expanded=true]{
      --nav-bg:color-mix(in srgb, var(--color-neutral-100) 47%,var(--color-neutral-300));
      --inner-rows:var(--inner-height) calc(100dvh - var(--inner-height));
    }
  }
  .container {
    margin:0 auto;
    width: var(--container-width);
  }
  .cta {
    align-items: center;
    display: var(--cta-visibility);
    grid-column: 2;
    grid-row: 1;
    height: 100%;
    justify-content: flex-end;
    min-block-size: 0;
    min-inline-size: 0;
    width: 100%;
  }
  .inner {
    display: grid;
    grid-template-columns: var(--inner-cols);
    grid-template-rows:var(--inner-rows);
    overflow-y:var(--overflow);
    transition:var(--easing) grid-template-rows;
    width: 100%;
  }
  .brand,
  .settings {
    align-items: center;
    grid-row: 1;
  }

  .brand {
    display: flex;
    grid-column: 1;
    justify-content: flex-start;
    padding-left: var(--spacing);
  }
  .settings {
    display: var(--settings-visibility);
    grid-column: 2;
    justify-content: flex-end;
    padding-right: var(--spacing);
  }
  .menu {
    grid-column: 1/-1;
    grid-row: 2;
    height: 100%;
    min-block-size: 0;
    min-inline-size: 0;
    overflow: var(--overflow);
  }
  @media (width >= 1100px){
    .navigation {
      --container-width:min(1900px,99vw);
      --cta-visibility:flex;
      --inner-columns:20rem 1fr ;
      --inner-height:9rem;
      --nav-bg:transparent;
      --overflow:visible;
      --settings-visibility:none;
      --top:1rem;
      left: 50%;
      transform: translateX(-50%);
      &[data-expanded=true]{
        --nav-bg:transparent;
        --inner-rows:var(--inner-height) 0px;
      }
    }
    .cta {
      padding:0 calc(var(--spacing) / 3);
    }
    .container {
      display: grid;
      gap:0 1rem;
      grid-template-columns: var(--container-cols);
      grid-template-rows: var(--inner-height);
      position: relative;
    }
    .inner {
      background: var(--inner-bg);
      border-radius:var(--radius);
      padding: 0rem 2rem;
      position: relative;
    }
    .menu {
      grid-column: 2;
      grid-row: 1;
      padding-right: var(--spacing);
    }
  }
  @media (width >= 1600px){
    .navigation {
      --inner-height:7.5rem;
      --inner-cols:40rem 1fr;
      --container-cols:minmax(0,1fr) 25rem;
      --container-width:min(1900px,95vw);
    }
  }
  @media (prefers-reduced-motion: reduce){
    .navigation,
    .inner {
      transition: none;
    }
  }
</style>
