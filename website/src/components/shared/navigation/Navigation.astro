---
import { navigation } from "@static/navigation";
import { MenuButton } from "@common/buttons";
import { Brand, CallToAction, Menu } from "@shared/navigation";
const { brand, menu, callToAction } = navigation;
---

<div
x-data
class="navigation"
:data-expanded="$store.navigation.open"
:data-scrolled="$store.navigation.scrolled"
transition:persist="main-navigation"
>
<!-- <div
x-data
class="navigation"
:data-expanded="true"
:data-scrolled="$store.navigation.scrolled"
transition:persist="main-navigation"
> -->
  <div x-data class="container" :data-expanded="true">
    <nav class="inner">
      <div class="brand">
        <Brand brand={brand} uri="/" />
      </div>
      <div class="menu">
        <Menu
        menu={[...menu].sort((a, b) => a.order - b.order)}
        callToAction={callToAction}
        />
      </div>
      <div class="settings">
        <MenuButton />
      </div>
    </nav>
    <div class="cta">
      <CallToAction {...callToAction} variant="desktop" />
    </div>
  </div>
</div>
<style>
  .navigation {
    --cta-visibility:hidden;
    /* --container-width:min(1900px,92vw); */
    --container-width:100%;
    --inner-columns:minmax(0,1fr) 10rem;
    --inner-header-height:7.77rem;
    /* --inner-rows:5rem 0; */
    --spacing:1.75rem;
    background-color:var(--color-neutral-200);
    position: fixed;
    top: 0;
left: 0;
    transition: var(--easing) background-color;
    width: 100%;

    &[data-expanded=true]{
      background-color: color-mix(in srgb, var(--color-neutral-100) 50%,var(--color-neutral-300));
      .inner {
        grid-template-rows:var(--inner-header-height) calc(100vh - var(--inner-header-height));
      }
    }
  }
  .container {
    /* background: orange; */
    margin:0 auto;
    width: var(--container-width);
  }
  .cta {
    align-items: center;
    grid-column: 2;
    grid-row: 1;
    justify-content: flex-end;
    height: 100%;
    width: 100%;
    display: none;
      min-inline-size: 0;
  min-block-size: 0;
  }
  .inner {
    display: grid;
    grid-template-columns: var(--inner-columns);
    grid-template-rows: var(--inner-header-height) 0;
    transition:var(--easing) grid-template-rows;
    width: 100%;
    overflow-y: hidden;
  }
  .brand,
  .settings {
    align-items: center;
    display: flex;
    grid-row: 1;
  }

  .brand {
    justify-content: flex-start;
    /* background: white; */
    grid-column: 1;
    padding-left: var(--spacing);
  }
  .settings {
    /* background: red; */
    justify-content: flex-end;
    grid-column: 2;
    padding-right: var(--spacing);
  }
  .menu {
    /* background: aqua; */
    height: 100%;
    grid-column: 1/-1;
      min-block-size: 0;
  min-inline-size: 0;
    grid-row: 2;
    overflow: hidden;
  }

  @media (width >= 1100px){
    .navigation {
      --inner-header-height:9rem;
      --inner-columns:20rem 1fr ;
      --container-width:min(1900px,99vw);
      background-color: transparent;
      top:1rem;
          left: 50%;
    transform: translateX(-50%);
      &[data-expanded=true]{
        background-color: transparent;
        .inner {
          grid-template-rows:var(--inner-header-height) 0;
        }
      }
    }
    .cta {
      display: flex;
      padding:0 calc(var(--spacing) / 3);
    }
    .container {
      display: grid;
      gap:0 1rem;
      background-color: transparent;
      grid-template-rows: var(--inner-header-height);
      grid-template-columns: minmax(0,1fr) 15rem;
      position: relative;
    }
    .settings {
      /* background: green; */
      display: none;
    }
    .inner {
      background: var(--color-neutral-200);
      border-radius: 2rem;
      padding: 0rem 2rem;
      grid-template-rows:var(--inner-header-height) 0;
      position: relative;
      overflow: visible;
    }
    .menu {
      overflow: visible;
      padding-right: var(--spacing);
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (width >= 1600px){
    .navigation {
      --inner-header-height:7.5rem;
      --inner-columns:40rem 1fr ;
      --container-width:min(1900px,95vw);
      --spacing:1.75rem;
    }
    .brand {
      /* background: orangered; */
    }
      .container {
      grid-template-columns: minmax(0,1fr) 25rem;
    }
    }
</style>
