---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";
interface Props extends Omit<NavigationMenuLink, "order"> {
  groups: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
      items: Array<Omit<NavigationMenuLink, "order">>;
    }
  >;
}
const { groups, ...link } = Astro.props;
const panelId = `mega-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
const hoverSupported =
  "window.matchMedia('(hover: hover) and (pointer: fine)').matches";
---

<div
  class="mega"
  @mouseenter={`if (${hoverSupported}) openMenu(${id})`}
  @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
>
  <Toggle panelId={panelId} {...link} />
  <div
    class="panel"
    :data-expanded={`activeMenu === ${id}`}
    :inert={`activeMenu !== ${id}`}
  >
    <div class="grid">
      {
        groups.map(({ items, ...link }) => {
          return (
            <div class="group">
              <Item {...link} variant="mega" />
              <div class="links">
                {items.map((item) => {
                  return <Item {...item} variant="mega-item" />;
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .mega {
    /* background: salmon; */
    width: 100%;
    border-bottom: 1px solid --transparentColor(var(--color-neutral-900),.25);
    /* position: relative; */
  }
  .panel {
    display: grid;
    overflow: hidden;
    grid-template-rows:0fr;
    transition: var(--easing) grid-template-rows;
    &[data-expanded=true]{
     grid-template-rows:1fr;
      .grid {
        padding:.5rem .25rem 3.5rem .25rem;
      }
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(1,1fr);
    min-height: 0;
    gap:2.35rem 0;
     padding: 0 .25rem;
    transition: var(--easing) padding;
  }
  .links {
    align-items: flex-start;
    display: flex;
    flex-flow: column;
    padding:.25rem 1.95rem;
    gap:1.25rem 0;
    justify-content: flex-start;
  }
  @media (width >= 1100px){  
    .mega {
      width: auto;
      border-bottom: 0;
      
    }
    .panel {
      background-color: var(--color-neutral-200);
      position: absolute;
      border-radius: 0 0 1rem 1rem ;
      display: block;
      left: 0;
      overflow: hidden;
      opacity: 0;
      transform-origin: top;
      transform:translateY(-12px);
      right: 0;
      transition: var(--easing) height, var(--easing) opacity, var(--easing) transform;
        &[data-expanded="true"]{
          opacity: 1;transform:translateY(0);
          .grid {
            padding: 3rem;
          }    
        }
    }
    .grid {
      grid-template-columns: repeat(2,1fr);
      padding: 3rem;
      gap:1rem;
    }
 }
 @media (width >= 1600px){ 
  .grid {
      grid-template-columns: repeat(4,1fr);
    }
 }
</style>
