---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";
interface Props extends Omit<NavigationMenuLink, "order"> {
  groups: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
      items: Array<Omit<NavigationMenuLink, "order">>;
    }
  >;
}
const { groups, ...link } = Astro.props;
const panelId = `mega-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
const hoverSupported =
  "window.matchMedia('(hover: hover) and (pointer: fine)').matches";
---

<div
  class="mega"
  @mouseenter={`if (${hoverSupported}) openMenu(${id})`}
  @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
>
  <Toggle panelId={panelId} {...link} />
  <div
    class="panel"
    :data-expanded={`activeMenu === ${id}`}
    :inert={`activeMenu !== ${id}`}
  >
    <div class="grid">
      {
        groups.map(({ items, ...link }) => {
          return (
            <div class="group">
              <Item {...link} variant="mega" />
              <div class="links">
                {items.map((item) => {
                  return <Item {...item} variant="mega-item" />;
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .mega {
    --animation: 0.17s ease-in-out;
    --background: var(--color-base-200);
    --columns: repeat(4, 1fr);
    --gap-grid: 1rem 0;
    --gap-links: 0.65rem 0;
    --padding: 1rem 0 0 0;
    --rows: 0fr;
    --shadow: 0 0 1px 1.5px --transparentColor(var(--color-base-1300), 0.85);
    width: 100%;
  }
  .panel {
    display: grid;
    grid-template-rows: var(--rows);
    transition: var(--animation) grid-template-rows;
    &[data-expanded="true"] {
      --rows: 1fr;
    }
  }
  .grid {
    display: grid;
    gap: var(--gap-grid);
    min-height: 0;
    overflow: hidden;
    padding: var(--padding);
  }
  .links {
    display: flex;
    flex-flow: column;
    gap: var(--gap-links);
  }
  @media (width > 599px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width > 1049px) {
    .mega {
      --gap-grid: 3rem;
      --gap-links: 0.85rem 0;
      --padding: 3rem;
      position: static;
      width: fit-content;
    }

    .panel {
      background: var(--background);
      border-radius: 1rem;
      box-shadow: var(--shadow);
      corner-shape: scoop;
      display: block;
      left: 0;
      opacity: 0;
      position: absolute;
      right: 0;
      top: 100%;
      transform: translateY(0.5rem);
      transition:
        var(--animation) opacity,
        var(--animation) transform;
      z-index: 999;
      width: 100%;
      &[data-expanded="true"] {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .grid {
      grid-template-columns: var(--columns);
      overflow: visible;
    }
  }
</style>
