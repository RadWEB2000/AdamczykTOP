---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";
interface Props extends Omit<NavigationMenuLink, "order"> {
  groups: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
      items: Array<Omit<NavigationMenuLink, "order">>;
    }
  >;
}
const { groups, ...link } = Astro.props;
const panelId = `mega-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
const hoverSupported =
  "window.matchMedia('(hover: hover) and (pointer: fine)').matches";
---

<div
  class="mega"
  x-data="{expanded:false}"
  @mouseenter={`if (${hoverSupported}) openMenu(${id})`}
  @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
>
  <Toggle panelId={panelId} {...link} />
  <div
    class="panel"
    @mouseleave={`if (${hoverSupported}) closeMenu(${id})`}
    :data-expanded={`activeMenu === ${id}`}
    :inert={`activeMenu !== ${id}`}
  >
    <div class="grid">
      {
        groups.map(({ items, ...link }) => {
          return (
            <div class="group">
              <Item {...link} variant="mega" />
              <div class="links">
                {items.map((item) => {
                  return <Item {...item} variant="mega-item" />;
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .mega {
    width: 100%;
  }
  .panel {
    --rows: 0fr;
    display: grid;
    grid-template-rows: var(--rows);
    transition:
      0.15s ease-in-out grid-template-rows,
      0.25s ease-in-out transform;
  }

  .panel[data-expanded="true"] {
    --rows: 1fr;
  }

  .grid {
    display: grid;
    gap: 1rem 0;
    min-height: 0;
    overflow: hidden;
    padding-top: 1rem;
  }
  .links {
    display: flex;
    flex-flow: column;
    gap: 6.5px 0;
  }
  @media (width > 599px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width > 1049px) {
    .mega {
      position: static;
      width: fit-content;
    }

    .panel {
      background: var(--color-base-200);
      border-radius: 1rem;
      box-shadow: 0 0 1px 1.5px --transparentColor(var(--color-base-1300), 0.85);
      corner-shape: scoop;
      display: block;
      left: 0;
      opacity: 0;
      position: absolute;
      right: 0;
      top: calc(100% + 0rem);
      transform: translateY(0) scaleY(1);
      transform-origin: top;
      transition:
        0.15s ease-in-out opacity,
        0.15s ease-in-out transform,
        0.15s ease-in-out visibility;
      visibility: hidden;
      z-index: 999;
      width: 100%;
    }
    .panel[data-expanded="true"] {
      opacity: 1;
      transform: translateY(0) scaleY(1);
      transition:
        0.1s ease-in-out opacity,
        0.1s ease-in-out transform,
        0.1s ease-in-out visibility;
      visibility: visible;
    }

    .grid {
      display: grid;
      gap: 3rem;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
      padding: 3rem;
    }
    .links {
      gap: 8.5px 0;
    }
  }
</style>
