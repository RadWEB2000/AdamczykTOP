---
import type { NavigationMenuLink } from "@ts/navigation.types";
import { MenuItem as Item, MenuToggle as Toggle } from "@shared/navigation";
interface Props extends Omit<NavigationMenuLink, "order"> {
  groups: Array<
    Omit<NavigationMenuLink, "order"> & {
      description: string;
      items: Array<Omit<NavigationMenuLink, "order">>;
    }
  >;
}
const { groups, ...link } = Astro.props;
const panelId = `mega-${crypto.randomUUID()}`;
const id = JSON.stringify(panelId);
---

<div
  @mouseenter={`$store.navigation.onMenuEnter(${id})`}
  @mouseleave={`$store.navigation.onMenuLeave(${id})`}
  class="mega"
>
  <Toggle panelId={panelId} {...link} />
  <div
    :data-expanded={`$store.navigation.isMenuOpen(${id})`}
    :inert={`!$store.navigation.isMenuOpen(${id})`}
    class="panel"
    id={panelId}
  >
    <div class="grid">
      {
        groups.map(({ items, ...link }) => {
          return (
            <div class="group">
              <Item {...link} variant="mega" />
              <div class="links">
                {items.map((item) => {
                  return <Item {...item} variant="mega-item" />;
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .mega {
    --border:1px solid --transparentColor(var(--color-neutral-900),.25);
    --grid-cols:repeat(1,minmax(0,1fr));
    --grid-gap:2.35rem 0;
    --grid-pad:0 .25rem;
    --links-gap:1.25rem 0;
    --links-pad:.25rem 1.95rem;
    --opacity:1;
    --overflow:hidden;
    --panel-bg:transparent;
    --panel-display:grid;
    --panel-position:static;
    --panel-rows:0fr;
    --radius:0;
    --translate:0px;
    --width:100%;
    border-bottom:var(--border);
    width: var(--width);
    & > .panel {
      background-color: var(--panel-bg);
      border-radius: var(--radius);
      display: var(--panel-display);
      overflow: var(--overflow);
      grid-template-rows:var(--panel-rows);
      opacity: var(--opacity);
      position:var(--panel-position);
      transform: translateY(var(--translate));
      transition: var(--easing) grid-template-rows, var(--easing) opacity, var(--easing) transform;
      &[data-expanded=true]{
        --panel-rows:1fr;
        --grid-pad:.5rem .25rem 3.5rem .25rem;
      }
      & > .grid {
        display: grid;
        gap:var(--grid-gap);
        grid-template-columns: var(--grid-cols);
        min-height: 0;
        padding:var(--grid-pad);
        transition: var(--easing) padding;
        & > .group {
          & > .links {
            align-items: flex-start;
            display: flex;
            flex-flow: column;
            padding:var(--links-pad);
            gap:var(--links-gap);
            justify-content: flex-start;
          }
        }
      }
    }
  }
  @media (width >= 1100px){  
    .mega {
      --border:0;
      --grid-cols:repeat(2,minmax(0,1fr));
      --grid-gap:1rem;
      --grid-pad:3rem;
      --links-gap:1.25rem 0;
      --opacity:0;
      --panel-bg:var(--color-neutral-200);
      --panel-display:block;
      --panel-position:absolute;
      --panel-rows:1fr;
      --radius:0 0 1rem 1rem;
      --translate:-8px;
      --width:auto;
      & > .panel {
        left: 0;
        right: 0;
        &[data-expanded=true]{
          --grid-pad:3rem;
          --opacity:1;
          --translate:0px;
        }
        & > .grid {
          transition:none;
        }
      }
      
    }
 }
 @media (width >= 1600px){ 
  .mega {
      --grid-cols: repeat(4,minmax(0,1fr));
    }
 }
 @media (prefers-reduced-motion: reduce) {
  .grid,
  .panel {
    transition: none;
  }
 }
</style>
