---
interface Props {
  label: string;
  uri: string;
}

const { label, uri } = Astro.props;
---

<a href={uri}>
  {label}
</a>

<style>
  a {
    background-color: var(--color-accent-100);
    font-weight: 800;
    font-size: 2.25rem;
    text-transform: uppercase;
    padding: 1rem 2rem;
    transition:
      0.2s ease-in-out background-color,
      0.2s ease-in-out transform;
  }

  a:hover,
  a:focus {
    background-color: var(--color-accent-300);
    transform: scale(0.95);
  }
</style>
