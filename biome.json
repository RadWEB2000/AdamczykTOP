{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
      "cssModules":true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y":{
        "useAltText":"warn",
        "noSvgWithoutTitle":"info",
        "useHtmlLang":"info"
      },
      "performance":{
        "noImgElement":"info"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedProperties":"on",
        "useSortedAttributes":"on",
        "noDuplicateClasses":"on"
      }
    }
  }
}
